# Copy to .env for docker compose (docs/DEPLOY.md). .env is ignored by git.

# The secret people give once per browser to open Basis. At least 16 characters; make one with
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BASIS_ACCESS_TOKEN=

# The secret pipelines (The Factory's plugin, scripts) send as a bearer token to /v1. Leave empty to keep the API off.
BASIS_API_TOKEN=

# Host names besides localhost that people open Basis at, comma-separated, without ports: basis.internal,10.0.0.5
BASIS_HOSTS=
